# Copier vers .env.local (Next.js) — voir docs/SETUP.md pour l'ordre des étapes.

APP_ENV=dev                                  # dev | prod (filtre des voix Gemini)
AI_MODE=mock                                 # live | mock (mock : aucun appel réseau, coût 0)
JOBS_MODE=inline                             # trigger | inline (inline : pipeline dans le process Next, dev/E2E)
STORAGE_MODE=local                           # r2 | local (local : fichiers dans .data/storage, dev/E2E)
APP_URL=http://localhost:3000                # origine publique de l'app (liens magiques, CORS R2)

# Supabase — `pnpm db:start` affiche ces valeurs pour l'instance locale
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                         # serveur et tâches uniquement
ALLOWED_EMAILS=                              # emails autorisés, séparés par des virgules

# Gemini — clé du projet dev (free tier) en local, clé du projet prod en production
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-3.8-flash
GEMINI_MODEL_CHECK=gemini-3.5-flash-lite
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
GEMINI_MODEL_TTS_LITE=gemini-3.8-flash-lite-tts

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=murmure-audio

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Budget & limites
MONTHLY_BUDGET_USD=10
TTS_STANDARD_CONCURRENCY=4
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=80
MAX_SOURCE_CHARS=150000
DAILY_COURSE_LIMIT=5
